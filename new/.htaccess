# Ashoka Rescue - URL Rewriting Rules

RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Custom 404 page — LOCAL subfolder install.
# On the live server the site lives at /new/, so there this line must read:
#     ErrorDocument 404 /new/404.php
# (If the site ever moves to the domain root, use /404.php instead.)
ErrorDocument 404 "Page not found. Please return to the homepage."

# Disable MultiViews to prevent conflicts with serivces.php/service-detail.php
Options -MultiViews

# Relative substitutions work both at the production document root and when
# the project is served from a local XAMPP subdirectory.

# Canonical URL - Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.ashokarescue\.com$ [NC]
RewriteRule ^ https://ashokarescue.com%{REQUEST_URI} [R=301,L,NE]

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"

    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"

    # Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Redirect old .php URLs to new clean URLs (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^contact\.php$ contact [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^what-is-an-air-ambulance\.php$ service-detail?slug=charter-air-ambulance [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^ashoka-rescue-ambulance-services\.php$ service-detail?slug=ambulance-service [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^services\.php$ services [R=301,L]

# Additional legacy redirects
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^meet-our-air-ambulance-medical-crew\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^what-is-medical-transport-assistance-services\.php$ service-detail?slug=medical-tourism [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^what-all-medical-transport-assistance-equipments-used-while-transfering-a-pateint\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^air-ambulance-patient-and-crew-members-safety\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^what-is-an-air-ambu-lift\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^air-ambulance-in-dubai\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^oxygen-supply-onboard\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^air-ambulance-in-australia\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^air-ambulance-in-canada\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^air-ambulance-in-Bangladesh\.php$  [R=301,L]
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^flight-doctor-and-nurse\.php$  [R=301,L]

# Prevent direct access to includes directory
RewriteRule ^includes/.*$ - [F,L]

# Prevent direct access to sql directory
RewriteRule ^sql/.*$ - [F,L]

# Redirect old air-ambulance URL to new clean ambulance-service URL
RewriteCond %{THE_REQUEST} ^GET.*\.php [NC]
RewriteRule ^air-ambulance-medical-escort-services-india\.php$ services/air-ambulance-services-in-india [R=301,L]

# 301 Redirects for old service URLs to new SEO-friendly URLs
# 1. Air Ambulance Services
RewriteRule ^services/air-ambulance/?$ services/air-ambulance-services-in-india [R=301,L]

# 2. Charter Air Ambulance
RewriteRule ^services/charter-air-ambulance/?$ services/charter-air-ambulance-service-in-india [R=301,L]

# 3. Road Ambulance Service
RewriteRule ^services/ambulance-service/?$ services/road-ambulance-service-in-india [R=301,L]

# 4. Train Ambulance Service
RewriteRule ^services/train-ambulance/?$ services/train-ambulance-service-in-india [R=301,L]

# 5. Commercial Stretcher Service
RewriteRule ^services/commercial-stretcher/?$ services/commercial-stretcher-service [R=301,L]

# 6. Business Class Medical Assistance
RewriteRule ^services/business-class-assistance/?$ services/business-class-medical-assistance [R=301,L]

# 7. Medical Tourism India
RewriteRule ^services/medical-tourism/?$ services/medical-tourism-india [R=301,L]

# 8. Medical Escort and Transport
RewriteRule ^services/medical-escort/?$ services/medical-escort-and-transport [R=301,L]

# 9. Neonate Medical Transport Service
RewriteRule ^services/neonate-medical-transportation/?$ services/neonate-medical-transport-service [R=301,L]

# 10. Paediatric Medical Transport Service
RewriteRule ^services/paediatric-medical-transport/?$ services/paediatric-medical-transport-service [R=301,L]
RewriteRule ^services/Paediatric-medical-transport/?$ services/paediatric-medical-transport-service [R=301,L]

# Clean URLs for frontend pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about$ about.php [L,QSA]
RewriteRule ^contact$ contact.php [L,QSA]
RewriteRule ^faqs$ faqs.php [L,QSA]
RewriteRule ^terms$ terms.php [L,QSA]
RewriteRule ^privacy$ privacy.php [L,QSA]

# Blog URL - handle locally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/?$ https://ashokarescue.com/blog/ [R=302,L]

# Redirect old service-detail URLs with query strings to clean URLs
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^service-detail$ services/%1? [R=301,L]

# Generic Service Handler
# If a PHP file exists in services/ matching the request (e.g. /services/slug -> services/slug.php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^services/([^/]+)/?$ services/$1.php [L,QSA]

# Fallback to dynamic service detail page if file doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/?$ service-detail.php?slug=$1 [NC,L,QSA]

# Dynamic service detail pages - catch any slug and pass to service-detail.php
# This should be AFTER specific service pages to avoid conflicts
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)$ service-detail.php?slug=$1 [NC,L,QSA]

# Admin area clean URLs
RewriteRule ^admin$ admin/login.php [L]
RewriteRule ^admin/$ admin/login.php [L]

# Security: Prevent access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
# Disable directory browsing
Options -Indexes

# Set default index files
DirectoryIndex index.php index.html

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/xhtml+xml application/rss+xml application/atom+xml image/svg+xml
    AddOutputFilterByType DEFLATE application/x-javascript application/x-httpd-php application/x-httpd-fastphp
    # Don't compress images
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp)$ no-gzip dont-vary
</IfModule>

# Gzip compression
<IfModule mod_gzip.c>
    mod_gzip_on Yes
    mod_gzip_dechunk Yes
    mod_gzip_item_include file \.(html?|txt|css|js|php|pl)$
    mod_gzip_item_include mime ^application/x-javascript.*
    mod_gzip_item_include mime ^text/.*
    mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
    mod_gzip_item_exclude mime ^image/.*
    mod_gzip_item_include handler ^cgi-script$
</IfModule>

# Browser caching
# Source filenames are not content-hashed, so browsers must revalidate assets.
# This prevents replaced CSS, JavaScript, and images from remaining stale.
<IfModule mod_expires.c>
    ExpiresActive On
    # Images
    ExpiresByType image/jpg "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 0 seconds"
    ExpiresByType image/gif "access plus 0 seconds"
    ExpiresByType image/png "access plus 0 seconds"
    ExpiresByType image/webp "access plus 0 seconds"
    ExpiresByType image/svg+xml "access plus 0 seconds"
    ExpiresByType image/x-icon "access plus 0 seconds"
    # CSS and JavaScript
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType application/x-javascript "access plus 0 seconds"
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    # Other
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresDefault "access plus 1 day"
</IfModule>

# Add Vary: Accept-Encoding header
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|xml|gz|html)$">
        Header append Vary "Accept-Encoding"
    </FilesMatch>

    # Cache-Control headers for static assets
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|pdf)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Expires 0
    </FilesMatch>

    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=2592000, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Expires 0
    </FilesMatch>

    # No cache for HTML
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# UTF-8 encoding
AddDefaultCharset UTF-8

# PHP settings (if allowed)
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Private implementation and development files must not be served.
RewriteRule ^(?:includes|resources|docs|sql|tests|node_modules)(?:/|$) - [F,L]
<FilesMatch "^(?:\.env.*|package.*\.json|tailwind\.config\.cjs|README\.md)$">
    Require all denied
</FilesMatch>
