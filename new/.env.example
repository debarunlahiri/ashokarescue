# Export these in the PHP/Apache process environment; PHP does not auto-load this file.
SITE_URL=http://localhost:8080/ashokarescue/new
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=ashokrtech_cms
SMTP_PASSWORD=
BLOG_URL=https://ashokarescue.com/blog
APP_DEBUG=0
AI_CONCIERGE_ENABLED=true
# Use an absolute private directory writable by the PHP process.
# INQUIRY_RATE_DIR=/private/var/lib/ashoka/inquiry-rates

# Enable Places API (New) for the Google Cloud project and configure server-side.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# Optional generative responses; the source chatbot also supports guided replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
